# Database (RumptyCloud managed Postgres in prod)
# Local: `npx prisma dev --detach` then use the printed postgres:// URL, or Docker:
#   docker compose up -d
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kazi_check?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kazi_check?schema=public"

# LLM extraction (OpenAI-compatible chat/completions JSON schema).
# Leave LLM_API_KEY empty to use heuristic extract only.
# The model fills fields only — it never chooses the verdict.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# ThriveWave SMS / USSD
THRIVEWAVE_API_KEY=""
THRIVEWAVE_SHORT_CODE=""
THRIVEWAVE_WEBHOOK_SECRET=""

# Telegram bot (job scam checks via chat + uploads)
# Create via @BotFather, then setWebhook (see infra/TELEGRAM.md)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Optional — shown in /help and web UI when set (without @)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# App (must be an absolute https URL in production so SMS/Telegram links are clickable)
# NEXT_PUBLIC_APP_URL="https://kazi-check.rumptycloud.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
