generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CheckDirection {
  job_offer
  applicant
  offer_letter
}

enum SubjectKind {
  domain
  phone
  url
  handle
  email
}

enum RegistryStatus {
  unverified
  under_investigation
  confirmed
}

enum OrgReviewStatus {
  verified
  needs_review
}

model Check {
  id                 String         @id @default(cuid())
  direction          CheckDirection
  rawText            String
  url                String?
  verdict            String
  score              Float          @default(0)
  riskScore          Int            @default(0)
  riskBand           String         @default("LOW")
  recommendedAction  String         @default("")
  extracted          Json
  findings           Json           @default("[]")
  gaps               Json           @default("[]")
  confirmYourself    Json           @default("[]")
  officialListing    Json?
  notifyPhone        String?
  retroAlertedAt     DateTime?
  createdAt          DateTime       @default(now())
  evidence           Evidence[]
  subjects           CheckSubject[]
}

model Evidence {
  id          String  @id @default(cuid())
  checkId     String
  check       Check   @relation(fields: [checkId], references: [id], onDelete: Cascade)
  ruleId      String
  title       String
  snippet     String
  severity    String
  source      String?
  sourceType  String?
  retrievedAt String?
}

model Subject {
  id            String          @id @default(cuid())
  kind          SubjectKind
  key           String
  direction     CheckDirection?
  flagCount     Int             @default(0)
  summary       String          @default("")
  lastFlaggedAt DateTime?
  status        RegistryStatus  @default(unverified)
  isPublished   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  flags         Flag[]
  checks        CheckSubject[]

  @@unique([kind, key])
  @@index([flagCount])
}

model CheckSubject {
  checkId   String
  subjectId String
  check     Check   @relation(fields: [checkId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([checkId, subjectId])
}

model Flag {
  id              String   @id @default(cuid())
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  fingerprintHash String
  reason          String?
  createdAt       DateTime @default(now())

  @@unique([subjectId, fingerprintHash])
}

model DomainWhitelist {
  id        String   @id @default(cuid())
  domain    String   @unique
  orgName   String
  createdAt DateTime @default(now())
}

model Impersonation {
  id             String   @id @default(cuid())
  fakePattern    String
  officialDomain String
  orgName        String
  createdAt      DateTime @default(now())

  @@index([fakePattern])
}

model Organisation {
  id                 String              @id @default(cuid())
  name               String              @unique
  aliases            Json                @default("[]")
  category           String              @default("private")
  officialWebsite    String?
  careersUrl         String
  officialDomain     String
  officialApplyRoute String              @default("portal")
  applyUrl           String
  emailDomain        String
  listingTitle       String
  listingUrl         String
  dateIndexed        DateTime            @default(now())
  chargesFee         Boolean             @default(false)
  reviewStatus       OrgReviewStatus     @default(needs_review)
  domains            OrganisationDomain[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model OrganisationDomain {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  domain         String       @unique
  isEmailDomain  Boolean      @default(true)

  @@index([organisationId])
}

/** Job Bot queue. Masked text only — never raw unmasked ad bytes. */
model BotQueueItem {
  id             String    @id
  sourceType     String
  filename       String?
  status         String
  maskedText     String
  checkId        String?
  verdict        String?
  riskScore      Int?
  flaggedCount   Int?
  unknownCount   Int?
  gate           String?
  reason         String?
  gaps           Json      @default("[]")
  confirmedGaps  Json?
  draftText      String?
  apply          Json?
  notifyPhone    String?
  retroAlertedAt DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
  @@index([checkId])
}
